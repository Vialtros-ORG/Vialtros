# Backend — plantilla de variables de entorno
# Copia este archivo como .env y rellena los valores reales

DJANGO_SECRET_KEY=dev-only-placeholder-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Configuración de Base de Datos
# Por defecto se usará SQLite local si DB_ENGINE/DB_HOST no están definidos.
# Para PostgreSQL/Neon, descomenta y rellena los siguientes valores:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nombre_de_la_base
# DB_USER=usuario
# DB_PASSWORD=tu_password
# DB_HOST=localhost
# DB_PORT=5432


# Email para recuperación de contraseña (Gmail con App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=
FRONTEND_URL=http://localhost:3000

# Token para autenticar dispositivos GPS hardware (rastreadores, dongles USB, etc.)
# Usa este token en el header X-Tracking-Token al POST /api/tracking/ingest/
TRACKING_INGEST_TOKEN=

# Solo necesario en producción (DEBUG=False)
# CORS_ALLOWED_ORIGINS=https://www.vialtros.com

# Redis / Channels
REDIS_URL=

# Seguridad HTTPS
DJANGO_SECURE_SSL_REDIRECT=False

# CORS
